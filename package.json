{
  "name": "cashgear-fotoeditor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "setup:wasm": "node scripts/setup-wasm.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:wasm --release && pnpm --filter @fotoeditor/web build",
    "preview": "pnpm --filter @fotoeditor/web preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @fotoeditor/web typecheck",
    "test": "vitest run",
    "test:fixtures": "cargo run --release -p fotoeditor-io --example fixtures && cargo run --release -p fotoeditor-io --example layers -- bench/results/fixtures/layers-small.cgfoto 128 128 3 && cargo run --release -p fotoeditor-io --example extended_fixtures",
    "test:e2e": "pnpm test:fixtures && playwright test",
    "bench:viewport": "pnpm test:fixtures && node scripts/viewport-bench.mjs",
    "bench:brush": "pnpm test:fixtures && node scripts/brush-bench.mjs",
    "bench:history": "pnpm test:fixtures && node scripts/history-bench.mjs",
    "bench:selection": "node scripts/selection-bench.mjs",
    "bench:filters": "node scripts/filter-bench.mjs",
    "bench:geometry": "node scripts/geometry-bench.mjs",
    "bench:filter-preview": "node scripts/filter-preview-bench.mjs",
    "bench:adjustments": "node scripts/adjustment-bench.mjs",
    "bench:adjustment-preview": "node scripts/adjustment-preview-bench.mjs",
    "desktop:dev": "pnpm --filter @fotoeditor/desktop dev",
    "desktop:build": "pnpm build && pnpm --filter @fotoeditor/desktop build",
    "licenses:update": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:smoke": "pnpm test:fixtures && node scripts/desktop-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "binaryen": "^123.0.0",
    "eslint": "^10.13.0",
    "globals": "^16.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
