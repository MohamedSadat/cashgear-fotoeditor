{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CashGear FotoEditor",
  "version": "../package.json",
  "identifier": "com.cashgear.fotoeditor",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CashGear FotoEditor",
        "width": 1280,
        "height": 850,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyNjJGNkYxQzdCNjlDMDMKUldRRG5MYkg4ZlppNG1weVJUNk1NaWpHZ2h4Wk9mSmFYUUt1VUJ5azh0bXpUWWtjV0p0VXpsMVcK",
      "endpoints": [
        "https://github.com/MohamedSadat/cashgear-fotoeditor/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "publisher": "CashGear",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "installerHooks": "installer-hooks.nsh" }
    }
  }
}
